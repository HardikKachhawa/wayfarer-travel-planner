# LLM (any OpenAI-compatible endpoint serving Llama-3; Groq shown). Leave LLM_API_KEY empty to use the built-in offline generator.
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile
# Supabase (optional). Leave empty to store trips in backend/trips.json
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
CORS_ORIGINS=http://localhost:5173
